# ─── Public site URL (used for canonical URLs, sitemap, Open Graph) ───
NEXT_PUBLIC_SITE_URL=https://courses.abnaona-academy.com

# ─── Analytics / Pixels (leave empty to disable) ───
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Forms: contact / newsletter / "notify me" are POSTed as JSON to this webhook
# (e.g. Google Apps Script, Make.com, Zapier, n8n). Leave empty to only log on the server.
FORMS_WEBHOOK_URL=

